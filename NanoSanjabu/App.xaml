<Application x:Class="NanoSanjabu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NanoSanjabu"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--MainWindow.xaml 시작-->
       
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        </Style>

      
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

      
        <Style x:Key="ReportText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
        </Style>
        <!--MainWindow.xaml 스타일 끝-->
        
        <!--InputPartPage.xaml 시작-->
        <Style x:Key="KpiMiniCard" TargetType="Border">
            <Setter Property="Width" Value="270"/>
            <Setter Property="Height" Value="145"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="KpiBigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

     
        <Style x:Key="TrayCircle" TargetType="Border">
            <Setter Property="Width" Value="116"/>
            <Setter Property="Height" Value="116"/>
            <Setter Property="CornerRadius" Value="58"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

     
        <SolidColorBrush x:Key="StatusRun" Color="#00A36E"/>
        <SolidColorBrush x:Key="StatusComplete" Color="#5C70B8"/>
        <SolidColorBrush x:Key="StatusStop" Color="#8B949E"/>
        <!--InputPartPage.xaml 스타일 끝-->

    </Application.Resources>
</Application>
