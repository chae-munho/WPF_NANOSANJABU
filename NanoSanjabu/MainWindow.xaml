<Window x:Class="NanoSanjabu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES Platform"
        Width="1920" Height="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        
        Background="#0D1117">

    <Window.Resources>
      

        <!-- Nav Item Style -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C2128"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Item Style -->
        <Style x:Key="NavItemActive" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="Background" Value="#1C2128"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
        </Style>

        <!-- Window Control Button Base -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C2128"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button (Red hover) -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C93C37"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#A1302B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- WindowChrome for custom title bar with resize support -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <!-- CUSTOM TITLE BAR   -->
      
        <Grid Grid.Row="0" Background="#0D1117" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title Bar Text (optional, draggable area) -->
            <TextBlock Grid.Column="0"
                       Text="  MES Platform"
                       Foreground="#484F58"
                       FontSize="12"
                       FontFamily="Segoe UI, Malgun Gothic"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>

            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <!-- Minimize -->
                <Button Style="{StaticResource WindowControlBtn}"
                        Click="BtnMinimize_Click">
                    <TextBlock Text="&#xE921;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#8B949E"/>
                </Button>
                <!-- Maximize / Restore -->
                <Button x:Name="BtnMaximize"
                        Style="{StaticResource WindowControlBtn}"
                        Click="BtnMaximize_Click">
                    <TextBlock x:Name="MaximizeIcon"
                               Text="&#xE922;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#8B949E"/>
                </Button>
                <!-- Close -->
                <Button Style="{StaticResource CloseBtn}"
                        Click="BtnClose_Click">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#8B949E"/>
                </Button>
            </StackPanel>
        </Grid>

      
        <!-- MAIN LAYOUT  -->
      
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

           
            <!-- LEFT SIDEBAR  -->
          
            <Border Grid.Column="0"
                Background="#0D1117"
                BorderBrush="#21262D"
                BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Logo / Title -->
                    <TextBlock DockPanel.Dock="Top"
                           Text="MES Platform"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#00A36E"
                           FontFamily="Segoe UI, Malgun Gothic"
                           Margin="16,18,16,24"/>

                    <!-- Navigation -->
                    <StackPanel Margin="8,0">

                        <!-- Dashboard (Active) -->
                        <Button x:Name="BtnNavDashboard" Style="{StaticResource NavItemActive}" Margin="0,2" Click="BtnDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/images/dashboard.png"
                                   Width="16" Height="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                                <TextBlock Text="대시보드" VerticalAlignment="Center" Foreground="#E6EDF3"/>
                            </StackPanel>
                        </Button>

                        <!-- 투입부 -->
                        <Button x:Name="BtnNavInputPart" Style="{StaticResource NavItem}" Margin="0,2" Click="BtnInputPart_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/images/inputPart.png"
                                   Width="16" Height="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                                <TextBlock Text="투입부" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 적용부 -->
                        <Button x:Name="BtnNavLaminated" Style="{StaticResource NavItem}" Margin="0,2" Click="BtnLaminated_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/images/laminatedsection.png"
                                   Width="16" Height="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform" Cursor=""/>
                                <TextBlock Text="적용부" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 히스토리 -->
                        <Button x:Name="BtnNavHistory" Style="{StaticResource NavItem}" Margin="0,2" Click="BtnHistory_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/images/history.png"
                                   Width="16" Height="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                                <TextBlock Text="히스토리" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </DockPanel>
            </Border>

            <!---Main-->
          
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

               
                <!-- TOP BAR -->
             
                <Border Grid.Row="0"
                    Background="#0D1117"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                    <DockPanel VerticalAlignment="Center">
                      
                        <!-- Search Box -->
                        <Border DockPanel.Dock="Left"
                            Background="#161B22"
                            BorderBrush="#30363D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Width="322"
                            Height="40">

                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 돋보기 아이콘 -->
                                <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#FFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                                <!-- 실제 입력 -->
                                <TextBox Grid.Column="1"
                                     x:Name="SearchTextBox"
                                     FontSize="13"
                                     Foreground="#C9D1D9"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="#C9D1D9"
                                     Text=""
                                     Padding="0"
                                     />
                            </Grid>
                        </Border>


                        <!-- Date Display -->
                        <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#8B949E"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                            <TextBlock Text="2026년 2월 5일 목요일"
                                   Foreground="#C9D1D9"
                                   FontSize="13"
                                   FontFamily="Segoe UI, Malgun Gothic"
                                   VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Spacer -->
                        <Border/>
                    </DockPanel>
                </Border>

                
                <!--Main 영역 최상단-->
                <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   Margin="24,24,24,32"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
                <!---Main-->
                
                
                
            </Grid>
        </Grid>
    </Grid>
</Window>
