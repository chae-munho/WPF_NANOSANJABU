<Window x:Class="NanoSanjabu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES Platform"
        Width="1920" Height="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        
        Background="#0D1117">

    <Window.Resources>
        <!-- Base Text Style -->
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        </Style>

        <!-- Nav Item Style -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C2128"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Item Style -->
        <Style x:Key="NavItemActive" TargetType="Button" BasedOn="{StaticResource NavItem}">
            <Setter Property="Background" Value="#1C2128"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
        </Style>

        <!-- KPI Card Base Style -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <!-- Report Row Style -->
        <Style x:Key="ReportText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
        </Style>

        <!-- Window Control Button Base -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C2128"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button (Red hover) -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C93C37"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#A1302B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- WindowChrome for custom title bar with resize support -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- CUSTOM TITLE BAR                             -->
        <!-- ============================================ -->
        <Grid Grid.Row="0" Background="#0D1117" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title Bar Text (optional, draggable area) -->
            <TextBlock Grid.Column="0"
                       Text="  MES Platform"
                       Foreground="#484F58"
                       FontSize="12"
                       FontFamily="Segoe UI, Malgun Gothic"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>

            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <!-- Minimize -->
                <Button Style="{StaticResource WindowControlBtn}"
                        Click="BtnMinimize_Click">
                    <TextBlock Text="&#xE921;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#8B949E"/>
                </Button>
                <!-- Maximize / Restore -->
                <Button x:Name="BtnMaximize"
                        Style="{StaticResource WindowControlBtn}"
                        Click="BtnMaximize_Click">
                    <TextBlock x:Name="MaximizeIcon"
                               Text="&#xE922;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#8B949E"/>
                </Button>
                <!-- Close -->
                <Button Style="{StaticResource CloseBtn}"
                        Click="BtnClose_Click">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#8B949E"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================ -->
        <!-- MAIN LAYOUT (Sidebar + Content)              -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================ -->
            <!-- LEFT SIDEBAR                                 -->
            <!-- ============================================ -->
            <Border Grid.Column="0"
                Background="#0D1117"
                BorderBrush="#21262D"
                BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Logo / Title -->
                    <TextBlock DockPanel.Dock="Top"
                           Text="MES Platform"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#00A36E"
                           FontFamily="Segoe UI, Malgun Gothic"
                           Margin="16,18,16,24"/>

                    <!-- Navigation -->
                    <StackPanel Margin="8,0">

                        <!-- Dashboard (Active) -->
                        <Button Style="{StaticResource NavItemActive}" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/images/dashboard.png"
                                   Width="16" Height="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                                <TextBlock Text="대시보드" VerticalAlignment="Center" Foreground="#E6EDF3"/>
                            </StackPanel>
                        </Button>

                        <!-- 투입부 -->
                        <Button Style="{StaticResource NavItem}" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/images/inputPart.png"
                                   Width="16" Height="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                                <TextBlock Text="투입부" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 적용부 -->
                        <Button Style="{StaticResource NavItem}" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/images/laminatedsection.png"
                                   Width="16" Height="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                                <TextBlock Text="적용부" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 히스토리 -->
                        <Button Style="{StaticResource NavItem}" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/images/history.png"
                                   Width="16" Height="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                                <TextBlock Text="히스토리" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </DockPanel>
            </Border>

          
            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ======================================== -->
                <!-- TOP BAR                                  -->
                <!-- ======================================== -->
                <Border Grid.Row="0"
                    Background="#0D1117"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                    <DockPanel VerticalAlignment="Center">
                        <!-- Search Box -->
                        <!-- Search Box -->
                        <Border DockPanel.Dock="Left"
        Background="#161B22"
        BorderBrush="#30363D"
        BorderThickness="1"
        CornerRadius="6"
        Width="322"
        Height="40">

                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 돋보기 아이콘 -->
                                <TextBlock Grid.Column="0"
                   Text="&#xE721;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="14"
                   Foreground="#FFF"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

                                <!-- 실제 입력 -->
                                <TextBox Grid.Column="1"
                                     x:Name="SearchTextBox"
                                     FontSize="13"
                                     Foreground="#C9D1D9"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="#C9D1D9"
                                     Text=""
                                     Padding="0"
                                     />
                            </Grid>
                        </Border>


                        <!-- Date Display -->
                        <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#8B949E"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                            <TextBlock Text="2026년 2월 5일 목요일"
                                   Foreground="#C9D1D9"
                                   FontSize="13"
                                   FontFamily="Segoe UI, Malgun Gothic"
                                   VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Spacer -->
                        <Border/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="24,24,24,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 타이틀 -->
                        <RowDefinition Height="Auto"/>
                        <!-- KPI 1 -->
                        <RowDefinition Height="Auto"/>
                        <!-- KPI 2 -->
                        <RowDefinition Height="*"/>
                        <!-- 리포트 (여기만 스크롤) -->
                    </Grid.RowDefinitions>

                    <!-- Page Title -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="대시보드"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#5C70B8"
                           FontFamily="Segoe UI, Malgun Gothic"/>
                        <TextBlock Text="키랄성 나노구조체 바이오센서 제조 현황을 실시간으로 모니터링합니다"
                           FontSize="13"
                           Foreground="#5C70B8"
                           FontFamily="Segoe UI, Malgun Gothic"
                           Margin="0,4,0,20"/>
                    </StackPanel>

                  
                 
                    <!-- KPI 1 (4 cards) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card: 생산 수량 -->
                        <Border Grid.Column="0"
                            Style="{StaticResource KpiCard}"
                            Background="#141D2B"
                            Width="408" Height="200"
                            Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Text="생산 수량"
                                   FontSize="20"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"/>

                                <TextBlock Grid.Row="1"
                                   Text="1,234"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="#E6EDF3"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2"
                                   Text="+전일 대비 12.5% 증가"
                                   FontSize="12"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"
                                   Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Card: 합격률 -->
                        <Border Grid.Column="1"
                            Style="{StaticResource KpiCard}"
                            Background="#12282A"
                            Width="408" Height="200"
                            Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Text="합격률"
                                   FontSize="20"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"/>

                                <TextBlock Grid.Row="1"
                                   Text="98.7%"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="#E6EDF3"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2"
                                   Text="+전일 대비 12.5% 증가"
                                   FontSize="12"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"
                                   Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Card: 가동률 -->
                        <Border Grid.Column="2"
                            Style="{StaticResource KpiCard}"
                            Background="#1E2218"
                            Width="408" Height="200"
                            Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Text="가동률"
                                   FontSize="20"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"/>

                                <TextBlock Grid.Row="1"
                                   Text="98.3%"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="#E6EDF3"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2"
                                   Text="+1.3% 전일 대비"
                                   FontSize="12"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"
                                   Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Card: 재공 -->
                        <Border Grid.Column="3"
                            Style="{StaticResource KpiCard}"
                            Background="#1E1528"
                            Width="408" Height="200"
                            Margin="0, 0, 10, 0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Text="재공"
                                   FontSize="20"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"/>

                                <TextBlock Grid.Row="1"
                                   Text="5,689"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="#E6EDF3"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2"
                                   Text="+전일 대비 5.9% 증가"
                                   FontSize="12"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"
                                   Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- KPI 2 (2 cards) -->
                    <Grid Grid.Row="2" Margin="0,0,0,24">
                        <!-- KPI 1과 동일하게 4열 기준선을 만든다 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card: 불량 (1행의 1번째 카드와 같은 기준선) -->
                        <Border Grid.Column="0"
                            Style="{StaticResource KpiCard}"
                            Background="#141D2B"
                            Width="408" Height="200"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Left">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Text="불량"
                                   FontSize="20"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"/>

                                <TextBlock Grid.Row="1"
                                   Text="1.2%"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="#E6EDF3"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2"
                                   Text="+전일 대비 12.5% 증가"
                                   FontSize="12"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"
                                   Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Card: 완료 (1행의 2번째 카드와 같은 기준선) -->
                        <Border Grid.Column="1"
                            Style="{StaticResource KpiCard}"
                            Background="#12282A"
                            Width="408" Height="200"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Left">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Text="완료"
                                   FontSize="20"
                                   Foreground="#FFF"
                                   FontFamily="Segoe UI, Malgun Gothic"/>

                                <TextBlock Grid.Row="1"
                                   Text="14"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="#E6EDF3"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2"
                               Text="+전일 대비 12.5% 증가"
                               FontSize="12"
                               Foreground="#FFF"
                               FontFamily="Segoe UI, Malgun Gothic"
                               Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Grid.Column 2,3 은 비워둠 (오른쪽은 자연스럽게 빈 공간) -->
                    </Grid>





                    <!-- Report (여기만 스크롤) -->
                    <Border Grid.Row="3"
                        Background="#161B22"
                        CornerRadius="8"
                        Padding="24,20"
                        BorderBrush="#21262D"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                               Text="리포트"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               FontFamily="Segoe UI, Malgun Gothic"
                               Margin="0,0,0,16"/>

                            <!-- 리포트 로그만 스크롤 -->
                            <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ReportText}"
                               Text="2025-10-05 09:12 | LOT A23 | 합성 공정 시작 | 설비 M-01"/>
                                    <TextBlock Style="{StaticResource ReportText}"
                               Text="2025-10-08 09:28 | LOT A23 | 정상 가동 중"/>
                                    <TextBlock Style="{StaticResource ReportText}"
                               Text="2025-10-09 09:41 | LOT B11 | 건조 공정 오류 발생 | 온도 초과"/>
                                    <TextBlock Style="{StaticResource ReportText}"
                               Text="2025-10-09 09:42 | LOT B11 | 공정 정지"/>
                                    <TextBlock Style="{StaticResource ReportText}"
                               Text="2025-10-11 09:55 | LOT B11 | 오류 조치 완료 | 공정 재개"/>
                                    <TextBlock Style="{StaticResource ReportText}"
                               Margin="0"
                               Text="2025-10-14 10:07 | LOT A23 | 공정 완료 | 불량 0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
