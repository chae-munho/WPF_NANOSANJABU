<Page x:Class="NanoSanjabu.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="대시보드"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#5C70B8"
                       FontFamily="Segoe UI, Malgun Gothic"/>
            <TextBlock Text="키랄성 나노구조체 바이오센서 제조 현황을 실시간으로 모니터링합니다"
                       FontSize="13"
                       Foreground="#5C70B8"
                       FontFamily="Segoe UI, Malgun Gothic"
                       Margin="0,4,0,20"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCard}" Background="#141D2B" Width="408" Height="200" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="생산 수량" FontSize="20" Foreground="#FFF" FontFamily="Segoe UI, Malgun Gothic"/>
                    <TextBlock x:Name="TxtProductionCount"
                               Grid.Row="1"
                               Text="0"
                               FontSize="50"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Top"
                               Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource KpiCard}" Background="#12282A" Width="408" Height="200" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="합격률" FontSize="20" Foreground="#FFF" FontFamily="Segoe UI, Malgun Gothic"/>
                    <TextBlock x:Name="TxtPassRate"
                               Grid.Row="1"
                               Text="0%"
                               FontSize="50"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Top"
                               Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiCard}" Background="#141D2B" Width="408" Height="200" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="불량" FontSize="20" Foreground="#FFF" FontFamily="Segoe UI, Malgun Gothic"/>
                    <TextBlock x:Name="TxtDefectRate"
                               Grid.Row="1"
                               Text="0%"
                               FontSize="50"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Top"
                               Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource KpiCard}" Background="#12282A" Width="408" Height="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="완료" FontSize="20" Foreground="#FFF" FontFamily="Segoe UI, Malgun Gothic"/>
                    <TextBlock x:Name="TxtCompletedTrayCount"
                               Grid.Row="1"
                               Text="0"
                               FontSize="50"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Top"
                               Margin="0,6,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#161B22"
                Padding="24,20"
                BorderBrush="#21262D"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="리포트"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#E6EDF3"
                           FontFamily="Segoe UI, Malgun Gothic"
                           Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ReportItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ReportText}"
                                           Text="{Binding Message}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>