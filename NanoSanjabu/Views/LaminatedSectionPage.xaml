                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource LamTrayCircle}" Background="#D7F04A">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="[ Tray 1 ]" Style="{StaticResource LamTrayText}" FontWeight="SemiBold"/>
                                <TextBlock Text="LOT A1~5" Style="{StaticResource LamTrayText}"/>
                                <TextBlock Text="합성 중지" Style="{StaticResource LamTrayText}"/>
                                <TextBlock Text="COMPLETE" Style="{StaticResource LamTrayText}"/>
