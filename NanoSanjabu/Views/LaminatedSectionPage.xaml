                        <Border Grid.Row="2" Grid.Column="6" Style="{StaticResource LamTrayCircle}" Background="#D9D9D9">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="[ Tray 7 ]" Style="{StaticResource LamTrayText}" FontWeight="SemiBold"/>
                                <TextBlock Text="LOT A31~35" Style="{StaticResource LamTrayText}"/>
