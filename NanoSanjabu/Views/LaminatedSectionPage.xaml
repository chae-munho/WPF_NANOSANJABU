<Page x:Class="NanoSanjabu.Views.LaminatedSectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="259"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="259"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="259"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="259"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource LamKpiCard}" Background="#141D2B">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTotalGroupCount"
                                   Text="0"
                                   Style="{StaticResource LamKpiBigNumber}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="총 수량"
                                   Style="{StaticResource LamKpiLabel}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource LamKpiCard}" Background="#0E2442">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtRunningGroupCount"
                                   Text="0"
                                   Style="{StaticResource LamKpiBigNumber}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="진행 중"
                                   Style="{StaticResource LamKpiLabel}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource LamKpiCard}" Background="#2A2412">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtCompletedGroupCount"
                                   Text="0"
                                   Style="{StaticResource LamKpiBigNumber}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="완료"
                                   Style="{StaticResource LamKpiLabel}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource LamKpiCard}" Background="#0C2A27">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="0"
                                   Style="{StaticResource LamKpiBigNumber}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="에러"
                                   Style="{StaticResource LamKpiLabel}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#2A281F"
                    Padding="26"
                    BorderBrush="#21262D"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="5개 합성 트레이"
                               Foreground="#E6EDF3"
                               FontSize="13"
                               FontFamily="Segoe UI, Malgun Gothic"
                               Margin="0,0,0,14"/>

                    <ItemsControl x:Name="StackGroupItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LamTrayCircle}"
                                        Background="{Binding StatusBrush}"
                                        Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LotText}" Style="{StaticResource LamTrayText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource LamTrayText}"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource LamTrayText}"/>
                                        <TextBlock Text="{Binding ModeText}" Style="{StaticResource LamTrayText}"/>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource LamTrayText}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>