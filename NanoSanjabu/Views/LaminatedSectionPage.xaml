<Page x:Class="NanoSanjabu.Views.LaminatedSectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="259"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="259"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="259"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="259"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource LamKpiCard}" Background="#141D2B">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      
                        <TextBlock Text="10" Style="{StaticResource LamKpiBigNumber}"
                   TextAlignment="Center" HorizontalAlignment="Center"/>
                      
                        <TextBlock Text="총 수량" Style="{StaticResource LamKpiLabel}"
                   TextAlignment="Center" HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource LamKpiCard}" Background="#0E2442">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="3" Style="{StaticResource LamKpiBigNumber}"
                   TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="진행 중" Style="{StaticResource LamKpiLabel}"
                   TextAlignment="Center" HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource LamKpiCard}" Background="#2A2412">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="3" Style="{StaticResource LamKpiBigNumber}"
                   TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="완료" Style="{StaticResource LamKpiLabel}"
                   TextAlignment="Center" HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource LamKpiCard}" Background="#0C2A27">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="0" Style="{StaticResource LamKpiBigNumber}"
                   TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="에러" Style="{StaticResource LamKpiLabel}"
                   TextAlignment="Center" HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>



            </Grid>


            <Border Background="#2A281F"
                    CornerRadius="0"
                    Padding="26"
                    BorderBrush="#21262D"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="5개 합성 트레이"
                               Foreground="#E6EDF3"
                               FontSize="13"
                               FontFamily="Segoe UI, Malgun Gothic"
                               Margin="0,0,0,14"/>

                 
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="226"/>
                            <RowDefinition Height="33"/>
                            <RowDefinition Height="226"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="226"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="226"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="226"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="226"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="226"/>
                        </Grid.ColumnDefinitions>

                     

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LamTrayCircle}" Background="#FF3B30">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="[ Tray 2 ]" Style="{StaticResource LamTrayText}" FontWeight="SemiBold"/>
                                <TextBlock Text="LOT A6~10" Style="{StaticResource LamTrayText}"/>
                                <TextBlock Text="합성 중" Style="{StaticResource LamTrayText}"/>
                                <TextBlock Text="RUN" Style="{StaticResource LamTrayText}"/>
                                <TextBlock Text="12분 경과" Style="{StaticResource LamTrayText}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource LamTrayCircle}" Background="#D9D9D9">
