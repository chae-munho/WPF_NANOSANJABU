                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="8" Style="{StaticResource LamTrayCircle}" Background="#D9D9D9">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="[ Tray 9 ]" Style="{StaticResource LamTrayText}" FontWeight="SemiBold"/>
                                <TextBlock Text="LOT A41~45" Style="{StaticResource LamTrayText}"/>
                                <TextBlock Text="LOT 대기중" Style="{StaticResource LamTrayText}"/>
