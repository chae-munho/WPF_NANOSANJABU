<Page x:Class="NanoSanjabu.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="히스토리"
                   Style="{StaticResource TitleText}"
                   FontSize="20"/>

        <TextBlock Grid.Row="1"
                   Text="기간 요약 리포트"
                   Style="{StaticResource TitleText}"
                   FontSize="16"
                   Margin="0,18,0,10"/>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,18">
            <Border Style="{StaticResource CardBorder}" Background="#141A23" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="총 LOT 수" Style="{StaticResource LabelText}" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalLotCount" Grid.Row="1" Text="0" Style="{StaticResource ValueText}" FontSize="34" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Background="#12263B" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="총 생산 UNIT" Style="{StaticResource LabelText}" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalProducedUnit" Grid.Row="1" Text="0" Style="{StaticResource ValueText}" FontSize="34" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Background="#25231D" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="평균 공정 소요 시간" Style="{StaticResource LabelText}" FontSize="12"/>
                    <TextBlock x:Name="TxtAvgProcessMinutes" Grid.Row="1" Text="0" Style="{StaticResource ValueText}" FontSize="34" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Background="#0F2A2A">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="재작업 LOT" Style="{StaticResource LabelText}" FontSize="12"/>
                    <TextBlock x:Name="TxtReworkLotCount" Grid.Row="1" Text="0" Style="{StaticResource ValueText}" FontSize="34" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="최근 이벤트"
                       Style="{StaticResource TitleText}"
                       FontSize="14"
                       Margin="0,0,0,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="HistoryReportItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Background="#1A2230" Margin="0,0,12,12" Width="210" Height="140">
                                <StackPanel>
                                    <TextBlock Text="{Binding EventTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                               Style="{StaticResource TitleText}"
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Message}"
                                               Style="{StaticResource LabelText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>