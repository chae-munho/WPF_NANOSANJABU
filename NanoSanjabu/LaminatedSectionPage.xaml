<Page x:Class="NanoSanjabu.LaminatedSectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <StackPanel>
            <TextBlock Text="적용부(적층부)"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#5C70B8"
                       FontFamily="Segoe UI, Malgun Gothic"/>

            <TextBlock Text="(테스트 페이지) 여기부터 적용부(적층부) 화면 UI를 구현하면 됩니다."
                       FontSize="13"
                       Foreground="#5C70B8"
                       FontFamily="Segoe UI, Malgun Gothic"
                       Margin="0,4,0,20"/>

            <Border Background="#161B22"
                    CornerRadius="8"
                    Padding="24"
                    BorderBrush="#21262D"
                    BorderThickness="1">
                <TextBlock Text="적용부 콘텐츠 영역"
                           FontSize="16"
                           Foreground="#E6EDF3"
                           FontFamily="Segoe UI, Malgun Gothic"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
