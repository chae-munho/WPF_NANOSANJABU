<Page x:Class="NanoSanjabu.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
  
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
         
            <RowDefinition Height="Auto"/>
         
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="*"/>
           
        </Grid.RowDefinitions>

      
        <StackPanel Grid.Row="0">
            <TextBlock Text="대시보드"
             FontSize="18"
             FontWeight="SemiBold"
             Foreground="#5C70B8"
             FontFamily="Segoe UI, Malgun Gothic"/>
            <TextBlock Text="키랄성 나노구조체 바이오센서 제조 현황을 실시간으로 모니터링합니다"
             FontSize="13"
             Foreground="#5C70B8"
             FontFamily="Segoe UI, Malgun Gothic"
             Margin="0,4,0,20"/>
        </StackPanel>



      
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

           
            <Border Grid.Column="0"
              Style="{StaticResource KpiCard}"
              Background="#141D2B"
              Width="408" Height="200"
              Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                     Text="생산 수량"
                     FontSize="20"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"/>

                    <TextBlock Grid.Row="1"
                     Text="1,234"
                     FontSize="50"
                     FontWeight="Bold"
                     Foreground="#E6EDF3"
                     FontFamily="Segoe UI"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="2"
                     Text="+전일 대비 12.5% 증가"
                     FontSize="12"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"
                     Margin="0,8,0,0"/>
                </Grid>
            </Border>

          
            <Border Grid.Column="1"
              Style="{StaticResource KpiCard}"
              Background="#12282A"
              Width="408" Height="200"
              Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                     Text="합격률"
                     FontSize="20"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"/>

                    <TextBlock Grid.Row="1"
                     Text="98.7%"
                     FontSize="50"
                     FontWeight="Bold"
                     Foreground="#E6EDF3"
                     FontFamily="Segoe UI"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="2"
                     Text="+전일 대비 12.5% 증가"
                     FontSize="12"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"
                     Margin="0,8,0,0"/>
                </Grid>
            </Border>

            
            <Border Grid.Column="2"
              Style="{StaticResource KpiCard}"
              Background="#1E2218"
              Width="408" Height="200"
              Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                     Text="가동률"
                     FontSize="20"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"/>

                    <TextBlock Grid.Row="1"
                     Text="98.3%"
                     FontSize="50"
                     FontWeight="Bold"
                     Foreground="#E6EDF3"
                     FontFamily="Segoe UI"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="2"
                     Text="+1.3% 전일 대비"
                     FontSize="12"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"
                     Margin="0,8,0,0"/>
                </Grid>
            </Border>

           
            <Border Grid.Column="3"
              Style="{StaticResource KpiCard}"
              Background="#1E1528"
              Width="408" Height="200"
              Margin="0, 0, 10, 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                     Text="재공"
                     FontSize="20"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"/>

                    <TextBlock Grid.Row="1"
                     Text="5,689"
                     FontSize="50"
                     FontWeight="Bold"
                     Foreground="#E6EDF3"
                     FontFamily="Segoe UI"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="2"
                     Text="+전일 대비 5.9% 증가"
                     FontSize="12"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"
                     Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

       
        <Grid Grid.Row="2" Margin="0,0,0,24">
           
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

         
            <Border Grid.Column="0"
              Style="{StaticResource KpiCard}"
              Background="#141D2B"
              Width="408" Height="200"
              Margin="0,0,10,0"
              HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                     Text="불량"
                     FontSize="20"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"/>

                    <TextBlock Grid.Row="1"
                     Text="1.2%"
                     FontSize="50"
                     FontWeight="Bold"
                     Foreground="#E6EDF3"
                     FontFamily="Segoe UI"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="2"
                     Text="+전일 대비 12.5% 증가"
                     FontSize="12"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"
                     Margin="0,8,0,0"/>
                </Grid>
            </Border>


            <Border Grid.Column="1"
              Style="{StaticResource KpiCard}"
              Background="#12282A"
              Width="408" Height="200"
              Margin="0,0,10,0"
              HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                     Text="완료"
                     FontSize="20"
                     Foreground="#FFF"
                     FontFamily="Segoe UI, Malgun Gothic"/>

                    <TextBlock Grid.Row="1"
                     Text="14"
                     FontSize="50"
                     FontWeight="Bold"
                     Foreground="#E6EDF3"
                     FontFamily="Segoe UI"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="2"
                 Text="+전일 대비 12.5% 증가"
                 FontSize="12"
                 Foreground="#FFF"
                 FontFamily="Segoe UI, Malgun Gothic"
                 Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>


        <Border Grid.Row="3"
          Background="#161B22"
          CornerRadius="0"
          Padding="24,20"
          BorderBrush="#21262D"
              
             
          BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                 Text="리포트"
                 FontSize="20"
                 FontWeight="Bold"
                 Foreground="#E6EDF3"
                 FontFamily="Segoe UI, Malgun Gothic"
                 Margin="0,0,0,16"/>

             
                <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ReportText}"
                 Text="2025-10-05 09:12 | LOT A23 | 합성 공정 시작 | 설비 M-01"/>
                        <TextBlock Style="{StaticResource ReportText}"
                 Text="2025-10-08 09:28 | LOT A23 | 정상 가동 중"/>
                        <TextBlock Style="{StaticResource ReportText}"
                 Text="2025-10-09 09:41 | LOT B11 | 건조 공정 오류 발생 | 온도 초과"/>
                        <TextBlock Style="{StaticResource ReportText}"
                 Text="2025-10-09 09:42 | LOT B11 | 공정 정지"/>
                        <TextBlock Style="{StaticResource ReportText}"
                 Text="2025-10-11 09:55 | LOT B11 | 오류 조치 완료 | 공정 재개"/>
                        <TextBlock Style="{StaticResource ReportText}"
                 Margin="0"
                 Text="2025-10-14 10:07 | LOT A23 | 공정 완료 | 불량 0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>


</Page>
