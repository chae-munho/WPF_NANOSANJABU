<Page x:Class="NanoSanjabu.InputPartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

      
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiMiniCard}" Background="#121822">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="50" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="총 수량" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiMiniCard}" Background="#102237">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="48" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="대기" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource KpiMiniCard}" Background="#2A271E">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="3" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="진행 중" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource KpiMiniCard}" Background="#0C2B26">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="3" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="완료" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="8" Style="{StaticResource KpiMiniCard}" Background="#2A151A">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="0" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="에러" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="10" Style="{StaticResource KpiMiniCard}" Background="#1D1630">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="0" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="보류" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

       
        <TextBlock Grid.Row="2"
                   Text="트레이 A - 작업 중"
                   Foreground="#E6EDF3"
                   FontSize="13"
                   FontWeight="SemiBold"
                   FontFamily="Segoe UI, Malgun Gothic"
                   Margin="2,0,0,0"/>

      
        <Border Grid.Row="4"
                VerticalAlignment="Top"
                Background="#2A281F"
                BorderBrush="#21262D"
                BorderThickness="1"
                CornerRadius="0"
                Padding="18">

            <ItemsControl x:Name="TrayItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="5" Columns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="116" Height="116" Margin="5,5">

                           
                            <Border Style="{StaticResource TrayCircle}"
                                    Background="{Binding StatusBrush}"/>

                         
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TrayText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#111"
                                           FontFamily="Segoe UI, Malgun Gothic"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="10"
                                           Foreground="#222"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding TimeText}"
                                           FontSize="10"
                                           Foreground="#222"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Border>
    </Grid>
</Page>
