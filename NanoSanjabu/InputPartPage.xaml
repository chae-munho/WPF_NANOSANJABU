<Page x:Class="NanoSanjabu.InputPartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>

        <!-- 상단 KPI 카드 스타일 -->
        <Style x:Key="KpiMiniCard" TargetType="Border">
            <Setter Property="Width" Value="259"/>
            <Setter Property="Height" Value="142"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="KpiBigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- 하단 원 타일(116x116) : 배경색은 Binding으로 넣을거라 여기선 고정 Background 제거 -->
        <Style x:Key="TrayCircle" TargetType="Border">
            <Setter Property="Width" Value="116"/>
            <Setter Property="Height" Value="116"/>
            <Setter Property="CornerRadius" Value="58"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 상태 색(예시) -->
        <SolidColorBrush x:Key="StatusRun" Color="#00A36E"/>
        <SolidColorBrush x:Key="StatusComplete" Color="#5C70B8"/>
        <SolidColorBrush x:Key="StatusStop" Color="#8B949E"/>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 상단 KPI 6개 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
                <ColumnDefinition Width="0"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiMiniCard}" Background="#121822">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="50" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="총 수량" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiMiniCard}" Background="#102237">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="48" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="대기" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource KpiMiniCard}" Background="#2A271E">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="3" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="진행 중" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource KpiMiniCard}" Background="#0C2B26">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="3" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="완료" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="8" Style="{StaticResource KpiMiniCard}" Background="#2A151A">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="0" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="에러" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="10" Style="{StaticResource KpiMiniCard}" Background="#1D1630">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="0" Style="{StaticResource KpiBigNumber}"/>
                    <TextBlock Text="보류" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 섹션 타이틀 ===== -->
        <TextBlock Grid.Row="2"
                   Text="트레이 A - 작업 중"
                   Foreground="#E6EDF3"
                   FontSize="13"
                   FontWeight="SemiBold"
                   FontFamily="Segoe UI, Malgun Gothic"
                   Margin="2,0,0,0"/>

        <!-- ===== 원 50개 영역(5x10) ===== -->
        <Border Grid.Row="4"
                VerticalAlignment="Top"
                Background="#161B22"
                BorderBrush="#21262D"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">

            <ItemsControl x:Name="TrayItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="5" Columns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="116" Height="116" Margin="12,10">

                            <!--  상태색을 여기 배경으로 적용 -->
                            <Border Style="{StaticResource TrayCircle}"
                                    Background="{Binding StatusBrush}"/>

                            <!-- 중앙 텍스트 -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TrayText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#111"
                                           FontFamily="Segoe UI, Malgun Gothic"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="9"
                                           Foreground="#222"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding TimeText}"
                                           FontSize="9"
                                           Foreground="#222"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Border>
    </Grid>
</Page>
